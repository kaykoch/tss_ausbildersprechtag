[Unit]
Description=Gunicorn Untisanmeldung (8083)
After=network.target

[Service]
# Benutzer und Gruppe, unter der Gunicorn läuft
User=www-data
Group=www-data

# Arbeitsverzeichnis
WorkingDirectory=/var/www/tss_ausbildersprechtag/

# Umgebungsvariablen (z. B. für Virtualenv)
Environment="PATH=/var/www/tss_ausbildersprechtag/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Erstellt automatisch /var/log/gunicorn mit Rechten für www-data
RuntimeDirectory=gunicorn
RuntimeDirectoryMode=0755

# Gunicorn-Befehl direkt aus der venv
ExecStart=/var/www/tss_ausbildersprechtag/.venv/bin/gunicorn \
    --workers 2 \
    --bind 0.0.0.0:8083 \
    --log-level info \
    --access-logfile /var/log/gunicorn/tss_ausbildersprechtag_access.log \
    --error-logfile /var/log/gunicorn/tss_ausbildersprechtag_error.log \
    --timeout 30 \
    --graceful-timeout 10 \
    untis:app

# Automatischer Neustart bei Absturz
Restart=always
RestartSec=5

# Timeout für sauberes Beenden
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
